# Runtime values. Never commit real credentials. Use .dev.vars for local Wrangler,
# the Netlify site environment (Site configuration → Environment variables) in production.
SUPABASE_URL=
# Supabase > Project > Settings > API Keys > Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=
# Supabase > Project > Settings > API Keys > Secret key (sb_secret_...) — serveur uniquement.
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SITE_URL=https://marketpaperclip.com
# Other HTTPS origins serving the same site (comma-separated). A leading "*"
# matches one label, e.g. Netlify deploy previews.
SITE_ALIASES=https://www.marketpaperclip.com,https://marketpaperclip.netlify.app,https://*--marketpaperclip.netlify.app
# Confirmed accounts with these emails become moderators on sign-in.
MARKET_ADMIN_EMAILS=
# Decide the commercial rate before opening sales. Basis points: 1000 = 10%.
PLATFORM_FEE_BPS=
# "false" hides prices everywhere (catalogue preview). Default: shown.
SHOW_PRICES=true
PAYMENTS_ENABLED=false
LAUNCH_READY=false
GITHUB_AUTH_ENABLED=false
# Enable only after configuring the Google provider in Supabase Auth.
# Google client credentials belong in Supabase, never in frontend variables.
GOOGLE_AUTH_ENABLED=false
STRIPE_TAX_ENABLED=false
# Optional ownership tokens for Google Search Console and Bing Webmaster Tools (meta tags).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
